# Document Service — example environment variables.
# Copy to .env and set real values locally. Do not commit .env.
# In production, set these in the deployment (e.g. Kubernetes secrets, Docker env).

# Database (PostgreSQL)
DB_HOST=localhost
DB_USER=admin
DB_PASSWORD=change_me
DB_NAME=vokzal

# NATS
NATS_URL=nats://localhost:4222
NATS_USER=vokzal
NATS_PASSWORD=change_me

# MinIO (e.g. match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=vokzal-documents
