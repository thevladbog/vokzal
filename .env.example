# Вокзал.ТЕХ - Environment Variables
# Копируйте этот файл в .env и заполните значения для всех сервисов

# ==========================================
# ОБЩИЕ ПЕРЕМЕННЫЕ (используются всеми сервисами)
# ==========================================

# Database Configuration
VOKZAL_DB_USER=admin
VOKZAL_DB_PASSWORD=vokzal_secret_2026

# NATS Configuration
VOKZAL_NATS_URL=nats://localhost:4222
VOKZAL_NATS_USER=vokzal
VOKZAL_NATS_PASSWORD=nats_secret_2026

# Redis Configuration
VOKZAL_REDIS_PASSWORD=vokzal_redis_2026

# ==========================================
# JWT SECRETS (разные для каждого сервиса)
# ==========================================

# Auth Service JWT
VOKZAL_AUTH_JWT_SECRET=your-super-secret-jwt-key-for-auth-change-me-in-production

# Schedule Service JWT
VOKZAL_SCHEDULE_JWT_SECRET=your-super-secret-jwt-key-for-schedule-change-me-in-production

# Ticket Service JWT
VOKZAL_TICKET_JWT_SECRET=your-super-secret-jwt-key-for-ticket-change-me-in-production

# ==========================================
# ВНЕШНИЕ API (требуют регистрации)
# ==========================================

# Yandex Maps API (Geo Service)
VOKZAL_YANDEX_MAPS_API_KEY=your-yandex-maps-api-key

# SMS.ru API (Notify Service)
VOKZAL_SMS_API_ID=your-sms-ru-api-id

# Email Configuration (Notify Service)
VOKZAL_EMAIL_USERNAME=noreply@vokzal.tech
VOKZAL_EMAIL_PASSWORD=your-email-password

# Telegram Bot (Notify Service)
VOKZAL_TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Tinkoff Payment API (Payment Service)
VOKZAL_TINKOFF_TERMINAL_KEY=your-tinkoff-terminal-key
VOKZAL_TINKOFF_PASSWORD=your-tinkoff-password

# SBP Payment API (Payment Service)
VOKZAL_SBP_MERCHANT_ID=your-sbp-merchant-id
VOKZAL_SBP_API_KEY=your-sbp-api-key

# ==========================================
# ПРИМЕЧАНИЯ
# ==========================================

# ⚠️ ВАЖНО ДЛЯ PRODUCTION:
# 1. Используйте надежные пароли (минимум 20 символов, случайные)
# 2. Генерируйте уникальные JWT секреты для каждого сервиса
# 3. Храните .env файлы в секретных хранилищах (Vault, AWS Secrets Manager и т.д.)
# 4. Никогда не коммитьте .env файлы в Git
# 5. Используйте разные пароли для dev/staging/production окружений

# Генерация случайного секрета:
#   openssl rand -base64 32
#   или
#   head -c 32 /dev/urandom | base64
